# Nexus Passwords - configuration
#
# RUN LOCALLY
#   npm install
#   cp .env.example .env     (then set SESSION_SECRET below)
#   npm run dev              (http://localhost:3000)
#   Tests: npm run check; npm run e2e:install (once); npm run e2e
#
# DEPLOY ON VERCEL
#   1. Create a Postgres database on Neon and copy its connection string.
#   2. vercel env add DATABASE_URL     (paste the connection string)
#   3. vercel env add SESSION_SECRET   (random string, 32+ chars)
#   4. npx vercel deploy --prod
#   vercel.json runs `npm run db:migrate` before `npm run build`, so migrations
#   are applied at build time against DATABASE_URL.
#
# RATE LIMITING
#   Login (20/min), recovery verification (10/min) and public-key lookups (60/min) are rate limited per client IP
#   (first x-forwarded-for hop, else x-real-ip). The counters live in memory, per server instance: on Vercel each
#   serverless instance counts on its own and restarts reset them. For a public deployment also add a WAF rate-limit
#   rule (Vercel Firewall, Cloudflare, ...) on /api/auth/login, /api/auth/recovery/* and /api/users/public-key.
#
# Optional (local only): PGLITE_DIR overrides the PGlite folder (default .data/pglite);
# KEEP_DB=memory uses a throwaway in-memory database.
#
# BROWSER EXTENSION (Chrome / Edge / Brave, Manifest V3)
#   npm run ext:build      -> extension/dist (load it unpacked from chrome://extensions, developer mode)
#   npm run ext:zip        -> extension/release/*.zip for the Chrome Web Store (no key, no host_permissions)
#   In the extension popup, set the server URL (this app's https origin; http only for localhost) and
#   grant the permission it asks for. NEXUS_DEV_HOST=http://localhost:3100 npm run ext:build pre-grants a
#   local origin for development/E2E only. Details: extension/README-dev.txt

# Postgres connection (Neon / Vercel Postgres). Leave unset/empty to use embedded PGlite in .data/pglite
DATABASE_URL=
# Random secret with at least 32 characters, used to sign sessions
# (generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
